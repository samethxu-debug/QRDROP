{
  "name": "qr-share-app",
  "version": "1.0.0",
  "type": "module",
  "description": "QR Code Photo and File Sharing Web Application with Authentication",
  "main": "server/server.js",
  "scripts": {
    "build": "npm --prefix client install && npm --prefix client run build",
    "server": "node server/server.js",
    "client": "npm --prefix client run dev",
    "build:client": "npm --prefix client install && npm --prefix client run build",
    "install:all": "npm install && npm --prefix client install",
    "start": "node server/server.js",
    "dev": "concurrently \"node server/server.js\" \"npm --prefix client run dev\""
  },
  "dependencies": {
    "adm-zip": "^0.6.0",
    "archiver": "^7.0.1",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^9.1.0",
    "qrcode": "^1.5.3",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
